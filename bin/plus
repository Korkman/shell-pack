#! /usr/bin/env fish

# Plus: spawn command once pipe has data
# runs as its own process so fish does not buffer the pipeline feeding it

# loading shell-pack as a library so user can call `|+ SHELL_PACK_CMD`
# this does not load keybinds for non-interactive cases
load_shell_pack

if isatty stdin
	echo "plus: reads from a pipe, e.g.: cmd |+ ppage" >&2
	exit 1
end
test (count $argv) -gt 0; or set argv cat

# Read exactly 1 byte, held as octal (binary-safe, incl. NUL)
dd bs=1 count=1 2>/dev/null | od -An -v -to1 | read -l first_byte
set first_byte (string trim -- $first_byte)
test -n "$first_byte"; or exit 0 # EOF without data: nothing to do, don't spawn

# Stream the captured byte plus the rest of stdin downstream
begin
	command printf "\\$first_byte"
	cat
end | $argv
exit $pipestatus[-1]
