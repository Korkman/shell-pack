#!/bin/sh
# FAST callbacks for grasp / ppage fzf pager
# shellcheck disable=2329
{
	
set -eu

filter_prompt="(alt-f) filter> "
search_prompt="> "
# print a field of /proc/PID/status (Linux), or fall back to ps (BSD/macOS)
# NOTE: busybox ps lacks -p, so /proc has to be preferred
proc_info() {
	if [ -r "/proc/$1/status" ]; then
		case "$2" in
			comm) key="Name:" ;;
			ppid) key="PPid:" ;;
		esac
		awk -v k="$key" '$1 == k { print $2; exit }' "/proc/$1/status" 2>/dev/null
	else
		ps -o "$2=" -p "$1" 2>/dev/null | tr -d ' '
	fi
}

get_fzf_rss_kb() {
	# fzf runs transform/execute actions via `$SHELL -c`, so $PPID is that
	# shell, not fzf itself; walk up one more level to find fzf's real pid
	fzf_pid="$PPID"
	if [ "$(proc_info "$PPID" comm)" != "fzf" ]; then
		fzf_pid=$(proc_info "$PPID" ppid)
	fi
	[ -n "$fzf_pid" ] || return 0
	__sp_mem_usage_pid "$fzf_pid" 2>/dev/null || true
}

memory_guard() {
	# guard against fzf/search exhausting memory
	max_fzf_rss_kb="${GRASP_MAX_FZF_RSS_KB:-524288}"
	# throttle: measure at most once per second
	mem_cache="${GRASP_EXPORT_FILE:-}.mem"
	now=$(date +%s)
	if [ -n "${GRASP_EXPORT_FILE:-}" ] && [ -f "$mem_cache" ]; then
		read -r mem_time _ < "$mem_cache" || true
		if [ "${mem_time:-0}" = "$now" ]; then
			return 0
		fi
	fi
	fzf_rss_kb=$(get_fzf_rss_kb)
	if [ -n "$fzf_rss_kb" ]; then
		if [ -n "${GRASP_EXPORT_FILE:-}" ]; then
			printf '%s %s\n' "$now" "$fzf_rss_kb" > "$mem_cache"
		fi
		if [ "$fzf_rss_kb" -gt "$max_fzf_rss_kb" ]; then
			echo "unbind(result)+reload(echo 'Memory limit GRASP_MAX_FZF_RSS_KB reached ($fzf_rss_kb kb > $max_fzf_rss_kb kb). Immediate exit.')+show-input+clear-query+wait+accept"
		fi
	fi
}

toggle_raw() {
	if [ -n "${FZF_RAW:-}" ]; then
		printf %s "disable-raw+change-prompt($filter_prompt)+trigger(focus)"
	else
		printf %s "enable-raw+change-prompt($search_prompt)+trigger(focus)"
	fi
}

update_header() {
	# SGR reset: clear colors and attributes
	reset=$(printf '\033[0m')
	pos="$FZF_POS"
	if [ -z "${GRASP_PAGER:-}" ]; then
		# in grasp (non-pager) mode, show remaining lines as a negative count
		pos="$((FZF_TOTAL_COUNT - FZF_POS + 1))"
	fi
	pre="[line $pos/$FZF_TOTAL_COUNT] "
	ext=' (`'"${GRASP_SELF:-ppage}"'`, press h for help or q to quit)'
	if [ -n "${FZF_QUERY:-}" ]; then
		if [ -n "${FZF_RAW:-}" ]; then
			pre="[$FZF_MATCH_COUNT matches, line $pos/$FZF_TOTAL_COUNT, alt-f to filter] "
		else
			pre="[FILTERING, match $pos/$FZF_MATCH_COUNT, alt-f to unfilter] "
		fi
	fi
	
	# memory_guard (background) keeps this file current
	mem=''
	mem_kb=''
	if [ -n "${GRASP_EXPORT_FILE:-}" ] && [ -f "$GRASP_EXPORT_FILE.mem" ]; then
		read -r _ mem_kb < "$GRASP_EXPORT_FILE.mem" || true
	fi
	if [ -n "$mem_kb" ]; then
		mem=" [$((mem_kb / 1024)) MiB RAM]"
	fi

	GRASP_HEADER_TEXT="$pre$GRASP_HEADER_TEXT$ext$mem"
	printf 'change-header(%s %s %s)\n' "$GRASP_HEADER_BG$GRASP_HEADER_FG" "$GRASP_HEADER_TEXT" "$reset"
}

escape() {
	if [ "$FZF_INPUT_STATE" = "enabled" ]; then
		if [ "$FZF_QUERY" = "" ]; then
			echo 'show-header+hide-input+rebind('"$GRASP_PAGER_MODE_KEYS"')'
		else
			echo 'clear-query'
		fi
	else
		if [ "$FZF_QUERY" = "" ]; then
			echo 'abort'
		else
			# unfortunately we have to show the input to clear it :-/
			echo 'hide-header+show-input+clear-query+unbind('"$GRASP_PAGER_MODE_KEYS"')'
		fi
	fi
}

line_jump_read() {
	rm -f "$GRASP_JUMP_FILE"
	# switch to the alternate screen (like fzf itself) so the prompt doesn't clutter scrollback
	# done here rather than in fish's `read`, which leaves the alternate screen on its own
	# enter alternate screen, cursor home, show cursor
	printf '\033[?1049h\033[H\033[?25h'
	if [ -n "${FZF_RAW:-}" ]; then
		printf 'Jump to line: '
	else
		printf 'Jump to match: '
	fi
	read -r line
	# hide cursor, leave alternate screen
	printf '\033[?25l\033[?1049l'
	case "$line" in
		[1-9]*[0-9]|[1-9])
			echo "$line" > "$GRASP_JUMP_FILE"
			;;
	esac
}

line_jump_apply() {
	if [ -f "$GRASP_JUMP_FILE" ]; then
		line=$(cat "$GRASP_JUMP_FILE")
		rm -f "$GRASP_JUMP_FILE"
		echo "pos($line)"
	fi
}

emit_lines() {
	# select-all in stream mode (--tac) selects bottom-up; "reverse" restores input order
	if [ "$1" = reverse ]; then
		awk '{ l[NR] = $0 } END { for (i = NR; i > 0; i--) print l[i] }' "$2"
	else
		cat "$2"
	fi
}

all_lines_order() {
	if [ -z "${GRASP_PAGER:-}" ]; then
		echo reverse
	else
		echo keep
	fi
}

# print fzf action exporting {+f} (order: keep/reverse)
build_export() {
	emit="__sp_grasp_callback emit_lines $2 {+f}"
	case "$1" in
		save_as)
			# $3: url-escaped destination, collected by the save_as_prompt dialog (see grasp.fish)
			# only writes and reports, the tty is not read, so running from an event is fine
			printf '%s' "execute(__sp_grasp_callback save_to $3 $2 {+f})"
			;;
		save)
			printf '%s' "execute-silent($emit > \"\$GRASP_DUMPFILE\")+become(printf 'Saved to %s\\n' \"\$GRASP_DUMPFILE\"; exit 50)"
			;;
		print)
			printf '%s' "become($emit)"
			;;
		*)
			echo "Unknown grasp export action: $1" >&2
			return 2
			;;
	esac
}

# lines exported: selected ones, else matches when filtering, else all lines
export_action() {
	mode="$1"
	case "$mode" in
		save|save_as|print) ;;
		*) echo "Unknown grasp export action: $mode" >&2; return 2 ;;
	esac
	if [ "${LESSSECURE:-}" = 1 ] && [ "$mode" != print ]; then
		echo 'execute(__sp_grasp_callback save_denied)'
		return 0
	fi
	# save_as dialogs (see grasp.fish) run at key press: execute() triggered by an event
	# (see export_pending) can't read the tty reliably
	if [ "${FZF_SELECT_COUNT:-0}" -gt 0 ]; then
		if [ "$mode" = save_as ]; then
			echo "execute(__sp_grasp_callback save_as selected $FZF_SELECT_COUNT keep {+f})"
		else
			build_export "$mode" keep
			echo
		fi
	elif [ -n "${FZF_RAW:-}" ] && [ -n "${FZF_QUERY:-}" ]; then
		# unfiltered view: select-all would only pick matches, so search for everything first.
		# the export continues in export_pending once the 'result' event fires, then restores the search
		printf '%s' "$mode" > "$GRASP_EXPORT_FILE"
		if [ "$mode" = save_as ]; then
			# the prompt stores the destination in the pending export file
			echo "execute(__sp_grasp_callback save_as_prompt all $FZF_TOTAL_COUNT)+search()"
		else
			echo "search()"
		fi
	else
		order=$(all_lines_order)
		if [ "$mode" = save_as ]; then
			if [ -n "${FZF_QUERY:-}" ]; then
				kind=filtered
				count="$FZF_MATCH_COUNT"
			else
				kind=all
				count="$FZF_TOTAL_COUNT"
			fi
			echo "select-all+execute(__sp_grasp_callback save_as $kind $count $order {+f})+deselect-all"
		else
			printf '%s' "select-all+"
			build_export "$mode" "$order"
			echo
		fi
	fi
}

export_pending() {
	if [ ! -f "$GRASP_EXPORT_FILE" ]; then
		return 0
	fi
	mode=''
	dest=''
	read -r mode dest < "$GRASP_EXPORT_FILE" || true
	rm -f "$GRASP_EXPORT_FILE"
	if [ "$mode" = save_as ] && [ -z "$dest" ]; then
		# dialog cancelled: only restore the search
		printf '%s\n' 'transform-search(printf %s "$FZF_QUERY")'
		return 0
	fi
	printf '%s' 'select-all+'
	build_export "$mode" "$(all_lines_order)" "$dest"
	printf '%s\n' '+deselect-all+transform-search(printf %s "$FZF_QUERY")'
}

on_result() {
	header=$(update_header)
	pending=$(export_pending)
	if [ -n "$pending" ]; then
		printf '%s+%s\n' "$header" "$pending"
	else
		printf '%s\n' "$header"
	fi
}

CMD="$1"
shift
case "$CMD" in
	memory_guard|toggle_raw|update_header|on_result|escape|line_jump_read|line_jump_apply|emit_lines|export_save_action|export_save_as_action|export_print_action)
		case "$CMD" in
			export_save_action) export_action save ;;
			export_save_as_action) export_action save_as ;;
			export_print_action) export_action print ;;
			*) "$CMD" "$@" ;;
		esac
		;;
	*)
		# non-accelerated callback loops back to the original function
		exec grasp --fzf-callback "$CMD" "$@"
		;;
esac
exit
}