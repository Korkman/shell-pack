#!/bin/sh
# Print available memory in KB to stdout, or nothing if it cannot be determined.
set -eu

if [ -r /proc/meminfo ]; then
	# Linux: MemAvailable + ZFS ARC (if present)
	if [ -e /proc/spl/kstat/zfs/arcstats ]; then
		awk '/^MemAvailable:/ { ma=$2 } /^size/ { arc=$3 / 1024 } END { printf "%d\n", ma + (arc ? arc : 0) }' /proc/meminfo /proc/spl/kstat/zfs/arcstats
	else
		awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo
	fi
elif command -v vm_stat >/dev/null 2>&1 && command -v sysctl >/dev/null 2>&1; then
	# macOS: free+inactive+purgeable pages, converted from page size to KB
	page_size=$(sysctl -n hw.pagesize 2>/dev/null) || exit 0
	free_pages=$(vm_stat 2>/dev/null | awk '/^Pages (free|inactive|purgeable):/ { gsub(/\./, "", $NF); sum += $NF } END { print sum }')
	if [ -n "$page_size" ] && [ -n "$free_pages" ]; then
		awk -v p="$page_size" -v f="$free_pages" 'BEGIN { printf "%d\n", f * p / 1024 }'
	fi
elif command -v sysctl >/dev/null 2>&1; then
	# FreeBSD: free+inactive+cache (or laundry, on newer kernels)+zfs arc pages, like top(1)
	page_size=$(sysctl -n hw.pagesize 2>/dev/null) || exit 1
	pages_free=0
	for part in vm.stats.vm.v_free_count vm.stats.vm.v_inactive_count vm.stats.vm.v_cache_count vm.stats.vm.v_laundry_count
	do
		pages_free=$(( pages_free + $(sysctl -n $part 2>/dev/null || echo 0) ))
	done
	arc_free=$(sysctl -n kstat.zfs.misc.arcstats.size || echo 0)
	echo $(( pages_free * page_size / 1024 + arc_free / 1024 ))
else
	exit 2
fi
