#!/bin/sh
# Print available memory in KB to stdout, or nothing if it cannot be determined.
set -eu

if [ -r /proc/meminfo ]; then
	# Linux
	awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo
elif command -v vm_stat >/dev/null 2>&1 && command -v sysctl >/dev/null 2>&1; then
	# macOS: free+inactive+purgeable pages, converted from page size to KB
	page_size=$(sysctl -n hw.pagesize 2>/dev/null) || exit 0
	free_pages=$(vm_stat 2>/dev/null | awk '/^Pages (free|inactive|purgeable):/ { gsub(/\./, "", $NF); sum += $NF } END { print sum }')
	if [ -n "$page_size" ] && [ -n "$free_pages" ]; then
		awk -v p="$page_size" -v f="$free_pages" 'BEGIN { printf "%d\n", f * p / 1024 }'
	fi
elif command -v sysctl >/dev/null 2>&1; then
	# FreeBSD/other BSD: free pages * page size
	page_size=$(sysctl -n hw.pagesize 2>/dev/null) || exit 0
	free_pages=$(sysctl -n vm.stats.vm.v_free_count 2>/dev/null) || exit 0
	if [ -n "$page_size" ] && [ -n "$free_pages" ]; then
		awk -v p="$page_size" -v f="$free_pages" 'BEGIN { printf "%d\n", f * p / 1024 }'
	fi
else
	exit 2
fi
