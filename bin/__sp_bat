#! /bin/sh
{
	set -eu
	# bat wrapper reading STDIN: normalizes SGR escape sequences bat does not
	# understand into the semicolon form it does, then hands over to bat.
	#
	# Plain POSIX sh on purpose: this is spawned by fzf for every reload and
	# should not pay fish startup cost.
	#
	# - 38:5:N, 38:2:R:G:B and 38:2:CS:R:G:B (also 48) -> 38;5;N, 38;2;R;G;B
	# - 58:... (underline color, unsupported) -> 59
	# - 4:0 -> 24, 4:1 .. 4:5 -> 4

	ESC=$(printf '\033')
	# P: ESC[ plus any already normalized leading parameters
	P="($ESC\\[([0-9;]*;)?)"

	script=":a
	/$ESC\\[[0-9;]*:/{
	s/${P}58:[0-9:]*/\\159/
	s/${P}4:0/\\124/
	s/${P}4:[1-5]/\\14/
	s/${P}([34]8):2:[0-9]*:([0-9]*):([0-9]*):([0-9]*)/\\1\\3;2;\\4;\\5;\\6/
	s/${P}([34]8):2:([0-9]+):([0-9]+):([0-9]+)/\\1\\3;2;\\4;\\5;\\6/
	s/${P}([34]8):5:([0-9]+)/\\1\\3;5;\\4/
	ta
	}"

	# SP_SED_UNBUFFERED is exported by grasp (-u for GNU, -l for BSD, empty for none)
	# shellcheck disable=SC2086
	sed -E ${SP_SED_UNBUFFERED-} -e "$script" | bat "$@"
	exit
}
