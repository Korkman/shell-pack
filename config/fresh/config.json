// shell-pack config preset
{
  "version": 2,
  "locale": "en",
  // fresh's own updater is permanently disabled (it won't update at our custom location)
  // so shell-pack manages updates
  "check_for_updates": false,
  "self_update": false,
  "editor": {
    // nerd_font_icons is set in init.ts, depending on LC_NERDLEVEL
    "use_tabs": true,
    "tab_size": 3,
    "whitespace_tabs_leading": true,
    "whitespace_spaces_leading": false,
    "whitespace_spaces_trailing": false,
    "auto_close": true,
    "line_wrap": false,
    "indentation_guide": "none",
    "indentation_guide_glyph": "│",
    "rainbow_indentation": true,
    "rulers": [72, 120],
    "line_numbers": true,
    "rainbow_brackets": false,
    "highlight_matching_brackets": true,
    "auto_create_empty_buffer_on_last_buffer_close": false,
    "restore_previous_session": false
  },
  "file_explorer": {
    "auto_open_on_last_buffer_close": false,
    "follow_active_buffer": true,
    "show_hidden": true,
    "show_gitignored": true
  },
  "terminal": {
    "shell": {
      // make sure to remove TMUX from env so specific escapes don't confuse fresh
      "command": "/usr/bin/env",
      "args": [
        "-u", "TMUX", "sh", "-c", "exec $SHELL"
      ]
    }
  },
  "active_keybinding_map": "vscode",
  "keybindings": [
    {
      "modifiers": ["ctrl"], "key": "d",
      "action": "duplicate_line"
    },
    {
      "modifiers": ["ctrl"], "key": "l",
      "action": "goto_line"
    },
    {
      "modifiers": ["alt"], "key": "l",
      "action": "goto_line"
    },
    {
      "modifiers": ["ctrl"], "key": "g",
      "action": "goto_line"
    },
    // terminals in tabs yay!
    {
      "modifiers": ["ctrl"], "key": "t",
      "action": "open_terminal"
    },
    // some F-keys from midnight commander
    {
      "key": "F2",
      "action": "save"
    },
    {
      "key": "F4",
      "action": "query_replace"
    },
    {
      "key": "F5",
      "action": "copy"
    },
    {
      "key": "F8",
      "action": "delete_line"
    },
    {
      "key": "F9",
      "action": "menu_activate"
    },
    {
      "key": "F10",
      "action": "quit",
      "when": "global"
    },
    // prefer the classic interactive replace
    {
      "modifiers": ["ctrl"], "key": "r",
      "action": "query_replace"
    },
    {
      "modifiers": ["ctrl"], "key": "h",
      "action": "query_replace"
    },
    {
      "modifiers": ["ctrl"], "key": ",",
      "action": "open_settings"
    },
    // never too many keys to quit
    {
      "modifiers": ["alt"], "key": "q",
      "action": "quit",
      "when": "global"
    },
    {
      "modifiers": ["ctrl"], "key": "q",
      "action": "quit",
      "when": "normal"
    },
    // even force_quit gets a key
    {
      "modifiers": ["alt", "shift"], "key": "q",
      "action": "force_quit",
      "when": "global"
    },
    // default from vscode: ctrl-, to open settings
    {
      "modifiers": ["ctrl"], "key": ",",
      "action": "open_settings"
    },
    // since ctrl-, is not passing my terminal, add chord ctrl-k ,
    {
      "keys": [
        { "modifiers": ["ctrl"], "key": "k" },
        { "key": "," }
      ],
      "action": "open_settings"
    },
    // default from vscode: chord ctrl-k m to change language
    {
      "keys": [
        { "modifiers": ["ctrl"], "key": "k" },
        { "key": "m" }
      ],
      "action": "set_language"
    },
    // default from vscode: ctrl-k m ctrl-s to open keybinds
    {
      "keys": [
        { "modifiers": ["ctrl"], "key": "k" },
        { "modifiers": ["ctrl"], "key": "s" }
      ],
      "action": "open_keybinding_editor"
    },
    // add a chord to toggle comments in case ctrl-/ does not pass
    {
      "keys": [
        { "modifiers": ["ctrl"], "key": "k" },
        { "key": "/" }
      ],
      "action": "toggle_comment"
    },
    {
      "modifiers": ["ctrl"], "key": "e",
      "action": "toggle_file_explorer",
      "when": "fileExplorer"
    },
    {
      "modifiers": ["alt"], "key": "o",
      "action": "orchestrator_dock_toggle",
      "when": "global"
    },
    // several alternatives to switch buffers in case ctrl-pgup/-pgdn don't pass
    {
      "modifiers": ["alt"], "key": "t",
      "action": "switch_to_tab_by_name"
    },
    {
      "keys": [
        { "modifiers": ["ctrl"], "key": "k" },
        { "key": "right" }
      ],
      "action": "next_buffer"
    },
    {
      "keys": [
        { "modifiers": ["ctrl"], "key": "k" },
        { "key": "left" }
      ],
      "action": "prev_buffer"
    },
    // start a selection, then expand it with plain arrow keys (see init.ts)
    // alt-space is free (ctrl-space is LSP autocomplete) and alt survives
    // a raw linux VT console (sent as an ESC prefix)
    {
      "modifiers": ["alt"], "key": "space",
      "action": "shellpack_toggle_selection_mode"
    },
    // close_tab, but only when the active buffer isn't a terminal (see init.ts)
    {
      "modifiers": ["ctrl"], "key": "w",
      "action": "shellpack_close_tab_if_not_term"
    }
  ],
  "languages": {
    "yaml": {
      "tab_size": 2,
      "use_tabs": false
    },
    "json": {
      "tab_size": 2,
      "use_tabs": false
    }
  },
  "theme": "shell-pack.json"
}
