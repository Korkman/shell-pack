shell_patterns=0

##############################################################################
#   %%  The % character
#   %f  The current file (if non-local vfs, file will be copied locally and
#                         %f will be full path to it)
#   %p  The current file
#   %d  The current working directory
#   %s  "Selected files"; the tagged files if any, otherwise the current file
#   %t  Tagged files
#   %u  Tagged files (and they are untagged on return from expand_format)
#   %view Runs the commands and pipes standard output to the view command
#   If %view is immediately followed by '{', recognize keywords
#   ascii, hex, nroff and unform
#
#   If the format letter is in uppercase, it refers to the other panel
#
#   With a number followed the % character you can turn quoting on (default)
#   and off. For example:
#   %f    quote expanded macro
#   %1f   ditto
#   %0f   don't quote expanded macro
##############################################################################

.       Pass selected items to ...
        CMD=%{Enter command (fish shell)}
        set -- %s
        echo $CMD "$@" | fish -i

n       New file with template (create)
        FNAME=%{New file name, or space for README.md}
        [ "$FNAME" = " " ] && FNAME=README.md
        fishcall create "$FNAME" || (touch "$FNAME" && fishcall __sp_editor "$FNAME")

+ f \.zip$ | f \.tar$ | f \.tar\.[^.]+$ | f \.tgz$ | f \.tb2$ | f \.tbz$ | f \.tbz2$ | f \.tz2$ | f \.taz$ | f \.tlz$ | f \.txz$ | f \.tZ$ | f \.taZ$ | f \.tzst$ | f \.cpio$ | f \.7z$ | f \.gz$ | f \.zst$ | f \.bz2$ | f \.lz4$ | f \.lz$ | f \.lzma$ | f \.lzo$ | f \.xz$ | f \.Z$ & t r
x       Extract selected items
        for i in %s ; do
            fishcall cfd "$i" || exit
        done

+ t rd & ! f \.zip$ & ! f \.tar\.[^.]+$ & ! f \.tgz$ & ! f \.tb2$ & ! f \.tbz$ & ! f \.tbz2$ & ! f \.tz2$ & ! f \.taz$ & ! f \.tlz$ & ! f \.txz$ & ! f \.tZ$ & ! f \.taZ$ & ! f \.tzst$ & ! f \.cpio$ & ! f \.7z$ & ! f \.gz$ & ! f \.zst$ & ! f \.bz2$ & ! f \.lz4$ & ! f \.lz$ & ! f \.lzma$ & ! f \.lzo$ & ! f \.xz$ & ! f \.Z$
z       Compress each selected item
        DEST=%{Format: (tar.gz, xz) or space for (tar.)zst}
        for i in %s ; do
            if [ "$DEST" = " " ]; then
                if [ -d "$i" ]; then d=tar.zst; else d=zst; fi
            else
                d="$DEST"
            fi
            fishcall cfc "$i" "$d" || exit
        done

Z       Compress current subdirectory
        Pwd=$(basename %d /)
        DEST=%{New file, format (tar.xz, ...), or space for tar.zst}
        [ "$DEST" = " " ] && DEST=tar.zst
        cd .. && fishcall cfc "$Pwd" "$DEST"

+ t rl
d       diff tagged / opposing files
        set -- %t
        if [ $# -gt 2 ]; then
            echo "Tag at most two files to diff" >&2
            exit 1
        fi
        if [ $# -eq 2 ]; then
            diff --ignore-all-space --color=always -u "$1" "$2" | ${PAGER:-less}
        else
            diff --ignore-all-space --color=always -u %f %D/%F | ${PAGER:-less}
        fi

+ t rl
m       merge tagged / opposing files with mcdiff
        set -- %t
        if [ $# -gt 2 ]; then
            echo "Tag at most two files to diff" >&2
            exit 1
        fi
        if [ $# -eq 2 ]; then
            fishcall mcdiff -u "$1" "$2"
        else
            fishcall mcdiff -u %f %D/%F
        fi

+ t rdl
g       Search text in selected items
        PATTERN=%{Search pattern (regex)}
        fishcall rrg %s -- "$PATTERN"

+ t rl
f       Follow selected files with tail | grasp
        echo "following %s"
        set -- %s
        export STDIN_FILENAME=$1
        tail -n200 -f %s | fishcall grasp --syntax

+ t rl
b       Page file with bat syntax highlighting
        echo "paging %f"
        fishcall ppage --syntax %s
